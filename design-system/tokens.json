      "fast": "120ms",
      "normal": "200ms",
      "navigation": "260ms",
      "layout": "300ms",
      "enter": "320ms",
      "reveal": "480ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.22, 1, 0.36, 1)"
    },
    "transform": {
      "hoverLift": "-2px",
      "revealDistance": "8px"
    },
    "reducedMotionQuery": "(prefers-reduced-motion: reduce)"
  },
  "components": {
