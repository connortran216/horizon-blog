      "height": {
        "mobile": "64px",
        "desktop": "72px"
      },
      "maxWidth": "1120px",
      "bg": "bg.surface",
      "border": "border.subtle",
      "radius": "20px",
      "transition": "navigation",
      "itemRest": "text.secondary",
      "itemActive": "text.primary",
      "itemIndicator": "action.primary",
      "itemHoverBg": "action.subtle"
    },
    "control": {
      "radius": "12px",
      "paddingX": "16px",
      "minTouchTarget": "44px",
      "transition": "fast",
      "solidBg": "action.primary",
      "solidHoverBg": "action.hover",
      "solidFg": "text.onAction",
      "solidDisabledBg": "action.disabled",
      "quietFg": "text.secondary",
      "quietHoverBg": "action.subtle",
      "quietHoverFg": "text.primary",
      "disabledFg": "text.disabled",
      "dangerFg": "status.danger",
      "dangerSurface": "status.dangerSurface"
    },
    "field": {
      "radius": "12px",
      "transition": "fast",
      "bg": "bg.surface",
      "border": "border.control",
      "hoverBorder": "action.primary",
      "fg": "text.primary",
      "placeholder": "text.muted",
      "label": "text.secondary",
      "hint": "text.muted",
      "invalidBorder": "status.danger",
      "invalidText": "status.danger",
      "disabledBg": "bg.disabled",
      "disabledBorder": "border.disabled",
      "disabledFg": "text.disabled"
    },
    "card": {
      "radius": "20px",
      "padding": "24px",
      "transition": "normal",
      "title": {
        "fontSize": [
          "22px",
          "22px"
        ],
        "lineHeight": [
          "30px",
          "30px"
        ],
        "fontWeight": 600
      },
      "meta": {
        "fontSize": [
          "13px",
          "13px"
        ],
        "lineHeight": [
          "20px",
          "20px"
        ],
        "fontWeight": 500
      },
      "bg": "bg.surface",
      "border": "border.subtle",
      "hoverBg": "bg.subtle"
    },
    "feature": {
      "radius": "28px",
      "transition": "reveal",
      "bg": "bg.elevated",
      "border": "border.subtle",
      "accent": "accent.lime",
      "accentFg": "text.onAccent"
    },
    "reader": {
      "measure": "68ch",
      "prose": {
        "fontSize": [
          "18px",
          "19px"
        ],
        "lineHeight": [
          "30px",
          "32px"
        ],
        "fontWeight": 400
      },
      "codeRadius": "12px",
      "transition": "fast",
      "fg": "text.primary",
      "secondaryFg": "text.secondary",
      "link": "link.default",
      "codeBg": "bg.code",
      "selectionBg": "bg.selection",
      "progressTrack": "loading.track",
      "progressIndicator": "loading.indicator",
      "tocRest": "text.muted",
      "tocActive": "action.primary"
    },
    "series": {
      "radius": "20px",
      "coverRadius": "28px",
      "transition": "normal",
      "bg": "bg.surface",
      "border": "border.subtle",
      "connector": "border.subtle",
      "connectorActive": "action.primary",
      "partRest": "text.secondary",
      "partCurrent": "text.primary"
    },
    "feedback": {
      "radius": "20px",
      "transition": "normal",
      "neutralBg": "bg.subtle",
      "neutralFg": "text.secondary",
      "successBg": "status.successSurface",
      "successFg": "status.success",
      "warningBg": "status.warningSurface",
      "warningFg": "status.warning",
      "dangerBg": "status.dangerSurface",
      "dangerFg": "status.danger",
      "skeletonBase": "loading.base",
      "skeletonHighlight": "loading.highlight"
    },
    "workspace": {
      "radius": "12px",
      "transition": "fast",
      "bg": "bg.page",
      "panelBg": "bg.surface",
      "border": "border.subtle",
      "toolbarBg": "bg.subtle",
      "autosaveIdle": "text.muted",
      "autosaveSaving": "text.secondary",
      "autosaveSaved": "status.success",
      "autosaveFailed": "status.danger",
      "tableHeaderBg": "bg.subtle",
      "tableRowHoverBg": "bg.subtle",
      "tableBorder": "border.subtle"
    },
    "media": {
      "radius": "20px",
      "transition": "normal",
      "placeholderBg": "media.placeholder",
      "placeholderAccent": "media.placeholderAccent",
      "errorBg": "media.error",
      "errorFg": "status.danger"
    },
    "overlay": {
      "radius": "20px",
      "transition": "normal",
      "scrim": "bg.overlay",
      "bg": "bg.elevated",
      "border": "border.subtle"
    }
  }
